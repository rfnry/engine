{
  "description": "Compute one machine's vibration trend from its daily readings, in mm/s. Returns where it is measured, the first day, the number of readings, their mean and RMS, the slope of a least-squares line in mm/s per day, the machine's alert level, the last three readings and whether all three are above it; or an error when the machine has no readings.",
  "input_schema": {
    "type": "object",
    "properties": {
      "machine": {"type": "string", "description": "The machine, such as M-22 or MA-3"}
    },
    "required": ["machine"],
    "additionalProperties": false
  },
  "output_schema": {
    "oneOf": [
      {
        "type": "object",
        "required": [
          "machine",
          "point",
          "since",
          "readings",
          "mean",
          "rms",
          "slope_per_day",
          "alert",
          "last",
          "above_alert"
        ],
        "properties": {
          "machine": {"type": "string"},
          "point": {"type": "string"},
          "since": {"type": "string"},
          "readings": {"type": "integer", "minimum": 2},
          "mean": {"type": "number", "minimum": 0},
          "rms": {"type": "number", "minimum": 0},
          "slope_per_day": {"type": "number"},
          "alert": {"type": "number"},
          "last": {"type": "array", "items": {"type": "number"}, "maxItems": 3},
          "above_alert": {"type": "boolean"}
        }
      },
      {
        "type": "object",
        "required": ["error"],
        "properties": {"error": {"type": "string"}},
        "additionalProperties": false
      }
    ]
  }
}
