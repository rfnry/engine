{
  "description": "Fetch an order by its id. Returns the order: its customer, items, total, card, status, carrier and tracking number, the promised and delivered dates, and every charge.",
  "input_schema": {
    "type": "object",
    "properties": {
      "order_id": {"type": "string", "description": "The order id, such as A-1001"}
    },
    "required": ["order_id"]
  },
  "output_schema": {
    "oneOf": [
      {
        "type": "object",
        "required": ["customer", "items", "total", "card", "placed", "status", "promised", "charges"],
        "properties": {
          "customer": {"type": "string"},
          "items": {"type": "array", "items": {"type": "string"}},
          "total": {"type": "number"},
          "card": {"type": "string"},
          "placed": {"type": "string"},
          "status": {"enum": ["processing", "in transit", "delivered"]},
          "carrier": {"type": ["string", "null"]},
          "tracking": {"type": ["string", "null"]},
          "promised": {"type": "string"},
          "delivered": {"type": ["string", "null"]},
          "charges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "amount"],
              "properties": {"date": {"type": "string"}, "amount": {"type": "number"}}
            }
          }
        }
      },
      {
        "type": "object",
        "required": ["error"],
        "properties": {"error": {"type": "string"}},
        "additionalProperties": false
      }
    ]
  }
}
