{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dossier",
  "description": "One region's resources, as one surveyor found them, written as dossier.json in its working directory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "region",
    "terrain",
    "values",
    "notes",
    "simulated"
  ],
  "properties": {
    "region": {
      "description": "The region's id, one of the grid's 250 as the board names them, such as N00-15/3.",
      "type": "string",
      "pattern": "^[NS][0-9]{2}-[0-9]{2}/[0-9]+$"
    },
    "terrain": {
      "description": "What the region mostly is.",
      "enum": [
        "mare",
        "highland",
        "polar",
        "mixed"
      ]
    },
    "values": {
      "description": "Every value of the region: the range of the value across the region, what a mission would find in it, with the surveyor's confidence in that range and its sources, or unknown with the reason.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "water_ice",
        "TiO2",
        "FeO",
        "Al2O3",
        "Th",
        "He3"
      ],
      "properties": {
        "water_ice": {
          "description": "Water ice, the average in the top metre of regolith, in wt%. Concentrations in cold traps go in notes, not here.",
          "unit": "wt%",
          "$ref": "#/$defs/quantity",
          "properties": {
            "low": {
              "minimum": 0,
              "maximum": 100
            },
            "high": {
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "TiO2": {
          "description": "Titanium dioxide at the surface, in wt%.",
          "unit": "wt%",
          "$ref": "#/$defs/quantity",
          "properties": {
            "low": {
              "minimum": 0,
              "maximum": 20
            },
            "high": {
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "FeO": {
          "description": "Iron oxide at the surface, in wt%.",
          "unit": "wt%",
          "$ref": "#/$defs/quantity",
          "properties": {
            "low": {
              "minimum": 0,
              "maximum": 30
            },
            "high": {
              "minimum": 0,
              "maximum": 30
            }
          }
        },
        "Al2O3": {
          "description": "Aluminium oxide at the surface, in wt%.",
          "unit": "wt%",
          "$ref": "#/$defs/quantity",
          "properties": {
            "low": {
              "minimum": 0,
              "maximum": 40
            },
            "high": {
              "minimum": 0,
              "maximum": 40
            }
          }
        },
        "Th": {
          "description": "Thorium at the surface, in ppm.",
          "unit": "ppm",
          "$ref": "#/$defs/quantity",
          "properties": {
            "low": {
              "minimum": 0,
              "maximum": 20
            },
            "high": {
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "He3": {
          "description": "Helium-3 implanted by the solar wind in the regolith, in ppb.",
          "unit": "ppb",
          "$ref": "#/$defs/quantity",
          "properties": {
            "low": {
              "minimum": 0,
              "maximum": 100
            },
            "high": {
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "notes": {
      "description": "What else was found, in words.",
      "type": "string"
    },
    "simulated": {
      "description": "True only for a dossier a fake model wrote.",
      "type": "boolean"
    }
  },
  "$defs": {
    "quantity": {
      "oneOf": [
        {
          "$ref": "#/$defs/range"
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "high",
        "confidence",
        "sources"
      ],
      "properties": {
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "sources": {
          "description": "The dataset, missions, instruments, papers or fetched pages the range comes from; a URL starts with https://.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text",
            "anyOf": [
              {
                "pattern": "^https://"
              },
              {
                "not": {
                  "pattern": "^([A-Za-z][A-Za-z0-9+.-]*://|[Ww][Ww][Ww]\\.)"
                }
              }
            ]
          }
        }
      },
      "description": "A range from low to high, low at most high, with its confidence and sources."
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown"
      ],
      "properties": {
        "unknown": {
          "description": "Why nothing can be said.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "text": {
      "description": "A string with more than whitespace in it.",
      "type": "string",
      "pattern": "\\S"
    }
  }
}
